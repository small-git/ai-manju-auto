# AutoDL.art ComfyUI API token（令牌管理 → 分组选 ComfyUI）
# https://autodl.art/large-model/tokens
AUTODL_API_TOKEN=

# API root（一般不用改）
AUTODL_BASE_URL=https://autodl.art

# 默认分辨率：768p 横屏漫剧
DEFAULT_RESOLUTION=768p横
DEFAULT_DURATION=5

# 默认成片工作流别名（见 config/workflows.yaml）
DEFAULT_WORKFLOW=manhua_video_ref

POLL_INTERVAL_SEC=3
POLL_TIMEOUT_SEC=1800

# --- dsh-manhua：优先用工具箱 keys.set，勿把真钥提交进 git ---
# keys.set --provider autodl|openai|gemini
# 本地落盘：.manhua-secrets.json（已 gitignore）
OPENAI_API_KEY=
GEMINI_API_KEY=
PUBLIC_ASSET_BASE_URL=
