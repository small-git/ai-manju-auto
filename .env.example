# AutoDL.art ComfyUI API token（令牌管理 → 分组选 ComfyUI）
# https://autodl.art/large-model/tokens
AUTODL_API_TOKEN=

# API root（一般不用改）
AUTODL_BASE_URL=https://autodl.art

# 默认分辨率：768p 横屏漫剧
DEFAULT_RESOLUTION=768p横
DEFAULT_DURATION=5

# 默认成片工作流别名（见 config/workflows.yaml）
DEFAULT_WORKFLOW=manhua_video_ref

POLL_INTERVAL_SEC=3
POLL_TIMEOUT_SEC=1800
